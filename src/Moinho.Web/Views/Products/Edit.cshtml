@model ProductFormViewModel
@{
    var product = (Product)ViewBag.Product;
    ViewData["Title"] = "Editar produto";
}
<div class="page-header">
    <h1>Editar produto</h1>
    <span class="small text-body-secondary">Adicionado em @Display.DateTime(product.DateAdded)</span>
</div>
<form method="post" class="panel form-narrow" novalidate>
    <partial name="_Form" />
    <div class="mt-4 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@product.Id">Cancelar</a>
        <a class="btn btn-outline-danger ms-auto" asp-action="Delete" asp-route-id="@product.Id">Excluir</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
