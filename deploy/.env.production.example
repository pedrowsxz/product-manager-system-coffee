# Production settings. Copy to the repository root as .env on the server and fill in.
# Never commit the real file.

DOMAIN=moinho.seudominio.com.br

# Layout A (compose.prod.yaml): password for the bundled SQL Server.
MSSQL_SA_PASSWORD=troque-por-uma-senha-forte-1!

# Layout B (compose.shared.yaml): a login that can only use this app's database.
# CONNECTION_STRING=Server=sqlserver,1433;Database=Moinho;User Id=moinho_app;Password=...;TrustServerCertificate=True
# PROXY_NETWORK_CIDR=172.31.0.0/16   # docker network inspect proxy -> IPAM subnet

# Transactional SMTP (see docs/DEPLOY.md: Brevo or Resend).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Moinho <nao-responda@seudominio.com.br>

# The real admin account.
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte-2!

# Public demo (demo buttons, "Simular erro" and the 04:00 reset). false for a private install.
DEMO_ENABLED=true
