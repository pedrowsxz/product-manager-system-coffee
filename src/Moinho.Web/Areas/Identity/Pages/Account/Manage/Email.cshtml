@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
}
<h2 class="h5 mb-3">Email</h2>
<partial name="_StatusMessage" for="StatusMessage" />
@if (Model.IsProtectedDemo)
{
    <div class="alert alert-info py-2">Esta é uma conta de demonstração: o email não pode ser alterado.</div>
}
<form method="post" novalidate>
    <div class="mb-3">
        <label class="form-label">Email atual</label>
        <div class="input-group">
            <input class="form-control" value="@Model.Email" disabled />
            @if (Model.IsEmailConfirmed)
            {
                <span class="input-group-text text-success">Confirmado</span>
            }
        </div>
        @if (!Model.IsEmailConfirmed)
        {
            <button type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link px-0 small" formnovalidate>Reenviar email de confirmação</button>
        }
    </div>
    <fieldset disabled="@Model.IsProtectedDemo">
        <div class="mb-3">
            <label asp-for="Input.NewEmail" class="form-label"></label>
            <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" />
            <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
        </div>
        <button type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary">Trocar email</button>
    </fieldset>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
