@model Product
@{
    ViewData["Title"] = Model.Name;
}
<div class="page-header">
    <div>
        <a class="small" asp-action="Index">← Produtos</a>
        <h1 class="mt-1">@Model.Name</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Excluir</a>
    </div>
</div>
<partial name="_Flash" />
<div class="panel form-narrow">
    <dl class="row mb-0">
        <dt class="col-sm-4">SKU</dt><dd class="col-sm-8 sku">@Model.Sku</dd>
        <dt class="col-sm-4">Preço</dt><dd class="col-sm-8">@Display.Money(Model.Price)</dd>
        <dt class="col-sm-4">Estoque</dt><dd class="col-sm-8">@Model.StockQuantity un.</dd>
        <dt class="col-sm-4">Situação</dt>
        <dd class="col-sm-8">
            @if (Model.IsActive)
            {
                <span class="badge-soft badge-active">Ativo</span>
            }
            else
            {
                <span class="badge-soft badge-inactive">Inativo</span>
            }
        </dd>
        <dt class="col-sm-4">Descrição</dt><dd class="col-sm-8">@(Model.Description ?? "—")</dd>
        <dt class="col-sm-4">Adicionado em</dt><dd class="col-sm-8">@Display.DateTime(Model.DateAdded)</dd>
        <dt class="col-sm-4">Última alteração</dt><dd class="col-sm-8 mb-0">@(Model.UpdatedAt is { } u ? Display.DateTime(u) : "—")</dd>
    </dl>
</div>
