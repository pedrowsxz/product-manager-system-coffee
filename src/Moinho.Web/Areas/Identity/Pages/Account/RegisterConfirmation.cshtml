@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirme seu email";
}
<h1>Confirme seu email</h1>
@if (Model.EmailFailed)
{
    <div class="alert alert-warning">
        Sua conta foi criada, mas não conseguimos enviar o email de confirmação agora.
        Tente <a asp-page="./ResendEmailConfirmation">reenviar a confirmação</a> em alguns minutos.
    </div>
}
else
{
    <p>Enviamos um link de confirmação para o email informado. Abra a mensagem e clique em <strong>Confirmar email</strong> para poder entrar.</p>
    <p class="small text-body-secondary">Não chegou? Confira a caixa de spam ou <a asp-page="./ResendEmailConfirmation">reenvie a confirmação</a>.</p>
}
<a class="btn btn-outline-primary" asp-page="./Login">Ir para o login</a>
