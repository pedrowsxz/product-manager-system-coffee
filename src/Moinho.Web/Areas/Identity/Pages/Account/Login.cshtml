@page
@model LoginModel
@{
    ViewData["Title"] = "Entrar";
}
<h1>Entrar</h1>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="form-check">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label class="form-check-label small" asp-for="Input.RememberMe"></label>
        </div>
        <a class="small" asp-page="./ForgotPassword">Esqueci minha senha</a>
    </div>
    <button type="submit" class="btn btn-primary w-100">Entrar</button>
</form>

<div class="small text-center mt-3">
    Não tem conta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Cadastre-se</a>
    · <a asp-page="./ResendEmailConfirmation">Reenviar confirmação</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
