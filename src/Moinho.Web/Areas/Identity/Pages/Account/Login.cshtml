@page
@model LoginModel
@{
    ViewData["Title"] = "Entrar";
}
<h1>Entrar</h1>

@if (Model.DemoEnabled)
{
    <div class="demo-box">
        <div class="fw-semibold mb-1">Quer só conhecer o sistema?</div>
        <p class="small text-body-secondary mb-2">Entre com uma conta de demonstração, sem senha.</p>
        <div class="d-grid gap-2 d-sm-flex">
            <form method="post" asp-area="" asp-controller="Demo" asp-action="SignIn" asp-route-account="admin" class="flex-fill">
                <button type="submit" class="btn btn-primary w-100">Entrar como Admin (demo)</button>
            </form>
            <form method="post" asp-area="" asp-controller="Demo" asp-action="SignIn" asp-route-account="equipe" class="flex-fill">
                <button type="submit" class="btn btn-outline-primary w-100">Entrar como Equipe (demo)</button>
            </form>
        </div>
        <p class="small mt-2 mb-0">Ou <a asp-page="./Register">crie sua conta</a>: você receberá um email de confirmação de verdade.</p>
    </div>
    <div class="divider-text">ou entre com email e senha</div>
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="form-check">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label class="form-check-label small" asp-for="Input.RememberMe"></label>
        </div>
        <a class="small" asp-page="./ForgotPassword">Esqueci minha senha</a>
    </div>
    <button type="submit" class="btn btn-primary w-100">Entrar</button>
</form>

<div class="small text-center mt-3">
    Não tem conta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Cadastre-se</a>
    · <a asp-page="./ResendEmailConfirmation">Reenviar confirmação</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
