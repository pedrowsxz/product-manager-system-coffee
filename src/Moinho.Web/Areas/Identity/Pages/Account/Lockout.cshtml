@page
@model LockoutModel
@{
    ViewData["Title"] = "Conta bloqueada";
}
<h1>Conta bloqueada</h1>
<p>Esta conta está bloqueada. Após 5 tentativas de senha erradas o bloqueio dura 10 minutos; contas desativadas por um administrador ficam bloqueadas até serem reativadas.</p>
<a class="btn btn-outline-primary" asp-page="./Login">Voltar ao login</a>
