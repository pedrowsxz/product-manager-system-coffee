@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Verifique seu email";
}
<h1>Verifique seu email</h1>
<p>Se houver uma conta confirmada com esse email, você receberá em instantes um link para redefinir a senha. O link vale por 2 horas.</p>
<a class="btn btn-outline-primary" asp-page="./Login">Voltar ao login</a>
