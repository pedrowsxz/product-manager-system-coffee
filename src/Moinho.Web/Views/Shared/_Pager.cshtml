@using Microsoft.AspNetCore.WebUtilities
@model Pager
@{
    // Keep every current filter in the query string and only change "page".
    string Link(int page)
    {
        var query = Context.Request.Query.ToDictionary(q => q.Key, q => (string?)q.Value.ToString());
        query["page"] = page.ToString();
        return QueryHelpers.AddQueryString(Context.Request.Path, query);
    }
    var first = Math.Max(1, Model.Page - 2);
    var last = Math.Min(Model.TotalPages, Model.Page + 2);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <span class="small text-body-secondary">@Model.TotalCount registro(s) · página @Model.Page de @Model.TotalPages</span>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Paginação">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page - 1)">Anterior</a></li>
                @for (var p = first; p <= last; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page + 1)">Próxima</a></li>
            </ul>
        </nav>
    }
</div>
