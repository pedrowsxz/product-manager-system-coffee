@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Reenviar confirmação";
}
<h1>Reenviar confirmação</h1>
@if (Model.Sent)
{
    <div class="alert alert-success">Se existir uma conta não confirmada com esse email, enviamos um novo link de confirmação.</div>
    <a class="btn btn-outline-primary" asp-page="./Login">Ir para o login</a>
}
else
{
    <p class="text-body-secondary small">Informe o email usado no cadastro e enviaremos um novo link.</p>
    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Reenviar</button>
    </form>
    <div class="small text-center mt-3"><a asp-page="./Login">Voltar ao login</a></div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
