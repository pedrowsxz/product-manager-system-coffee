@model StaffCreateViewModel
@{
    ViewData["Title"] = "Convidar pessoa";
}
<div class="page-header"><h1>Convidar pessoa</h1></div>
<form method="post" class="panel form-narrow" novalidate>
    <p class="small text-body-secondary">A pessoa recebe um email com um link para definir a própria senha. Você nunca escolhe nem vê a senha de ninguém.</p>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Role" class="form-label"></label>
        <partial name="_RoleSelect" model="Model.Role" />
        <span asp-validation-for="Role" class="text-danger small"></span>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Enviar convite</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
