@page
@model ResetPasswordModel
@{
    ViewData["Title"] = Model.Invite ? "Definir sua senha" : "Redefinir senha";
}
<h1>@ViewData["Title"]</h1>
@if (Model.Invite)
{
    <p class="text-body-secondary small">Bem-vindo ao Moinho! Escolha a senha que você usará para entrar.</p>
}
<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <input asp-for="Input.Code" type="hidden" />
    <input asp-for="Invite" type="hidden" />
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
        <div class="form-text">Mínimo de 6 caracteres, com maiúscula, minúscula, número e símbolo.</div>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Salvar senha</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
