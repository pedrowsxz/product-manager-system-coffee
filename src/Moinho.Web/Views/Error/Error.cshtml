@model ErrorViewModel
@{
    ViewData["Title"] = "Algo deu errado";
}
<div class="status-page">
    <p class="status-code">500</p>
    <h1 class="h3">Algo deu errado</h1>
    <p class="text-body-secondary">Ocorreu um erro inesperado e ele já foi registrado. Tente novamente em instantes.</p>
    <p class="small mb-1">Código de rastreamento (informe ao administrador):</p>
    <p><code class="trace-id" data-testid="trace-id">@Model.TraceId</code></p>
    <a class="btn btn-primary" href="/">Voltar ao início</a>
</div>
