@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmação de email";
}
<h1>Confirmação de email</h1>
@if (Model.Succeeded)
{
    <div class="alert alert-success">Email confirmado! Você já pode entrar.</div>
    <a class="btn btn-primary w-100" asp-page="./Login">Entrar</a>
}
else
{
    <div class="alert alert-danger">Link inválido ou expirado.</div>
    <a class="btn btn-outline-primary" asp-page="./ResendEmailConfirmation">Reenviar confirmação</a>
}
