@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
}
<h2 class="h5 mb-3">Perfil</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<form method="post" novalidate>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input class="form-control" value="@Model.Email" disabled />
        <div class="form-text">Para trocar o email, use a aba <a asp-page="./Email">Email</a>.</div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.FullName" class="form-label"></label>
        <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
