@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Esqueci minha senha";
}
<h1>Esqueci minha senha</h1>
<p class="text-body-secondary small">Informe seu email. Se houver uma conta confirmada com ele, enviaremos um link para criar uma nova senha.</p>
<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Enviar link</button>
</form>
<div class="small text-center mt-3"><a asp-page="./Login">Voltar ao login</a></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
